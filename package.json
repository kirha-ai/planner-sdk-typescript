{
  "name": "@kirha/planner",
  "version": "0.2.0",
  "description": "SDK for tool-planning agents - generate and execute DAG execution plans from natural language",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check --write",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "ai",
    "llm",
    "agent",
    "tool-planning",
    "dag",
    "execution-plan",
    "openai"
  ],
  "author": "Kirha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirha-ai/planner-sdk-typescript"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "openai": "^7.15.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.4.1"
}
